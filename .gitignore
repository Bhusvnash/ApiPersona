# ==========================================
# Archivos de configuración de Git (.gitignore)
# Proyecto: C# / .NET API
# ==========================================

# ------------------------------------------
# Compilación y Salida de Archivos (Build Outputs)
# ------------------------------------------
# Carpetas de binarios y objetos generados durante la compilación
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
artifacts/

# ------------------------------------------
# Entornos de Desarrollo e IDEs (Visual Studio, VS Code, Rider)
# ------------------------------------------
# Archivos y carpetas específicas de Visual Studio
.vs/
*.csproj.user
*.user
*.userosscache
*.sln.docstates
*.suo
*.userprefs

# Visual Studio Code (Se ignora la carpeta general, pero se permiten configuraciones útiles del proyecto)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains Rider / ReSharper
.idea/
*_ReSharper*/
*.sln.iml

# ------------------------------------------
# Archivos Temporales y Registros (Logs)
# ------------------------------------------
[Ll]og/
[Ll]ogs/
*.log
*.binlog

# ------------------------------------------
# Secretos y Variables de Entorno
# ------------------------------------------
# Archivos de configuración con variables de entorno o credenciales sensibles
.env
.env.*
!.env.example

# ------------------------------------------
# Paquetes y Restauración de NuGet
# ------------------------------------------
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
project.lock.json
project.fragment.lock.json

# ------------------------------------------
# Cobertura de Código y Pruebas Unitarias
# ------------------------------------------
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
CodeCoverage/
*.coverage
*.coveragexml
*.VisualState.xml
TestResult.xml
nunit-*.xml

# ------------------------------------------
# Archivos del Sistema Operativo
# ------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Archivos temporales de editores
*~
~$*
*.tmp
*.bak

